@page "/admin/store/orders/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = StorePermissions.Orders)]
@inherits AppComponentBase
@inject IStoreOrderService Orders
<PageTitle>جزئیات سفارش</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">جزئیات سفارش</h3>
        <div class="text-body-secondary small">مشاهدهٔ اقلام، اطلاعات گیرنده و تغییر وضعیت</div>
    </div>
    <a href="/admin/store/orders" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i> بازگشت به فهرست
    </a>
</div>

@if (order is null)
{
    <div class="card-panel">
        @if (loading)
        {
            <LoadingSkeleton />
        }
        else
        {
            <div class="alert alert-warning mb-0">سفارش موردنظر پیدا نشد.</div>
        }
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success">@message</div>
    }

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card-panel mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h5 class="mb-1" dir="ltr" style="text-align:right;">@order.OrderNumber</h5>
                        <div class="text-body-secondary small">@order.CreatedAt.ToPersianDateTime() · @order.PaymentMethod.ToPersian()</div>
                    </div>
                    <span class="badge @order.Status.BadgeClass() fs-6">@order.Status.ToPersian()</span>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>محصول</th>
                                <th>قیمت واحد</th>
                                <th>تعداد</th>
                                <th>جمع</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in order.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@(item.ImageUrl ?? "/images/store/products/saffron.jpg")" alt="@item.ProductName"
                                                 style="width:42px; height:42px; object-fit:cover; border-radius:8px;" />
                                            <div>
                                                <div class="fw-semibold">@item.ProductName</div>
                                                <div class="text-body-secondary small">@item.Unit</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@StoreText.Price(item.UnitPriceTomans)</td>
                                    <td>@StoreText.PersianDigits(item.Quantity.ToString())</td>
                                    <td class="fw-semibold">@StoreText.Price(item.LineTotalTomans)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <div style="min-width:280px;">
                        <div class="d-flex justify-content-between py-1 small">
                            <span>جمع کالاها</span><strong>@StoreText.Price(order.SubtotalTomans)</strong>
                        </div>
                        <div class="d-flex justify-content-between py-1 small">
                            <span>هزینهٔ ارسال</span><strong>@(order.ShippingTomans == 0 ? "رایگان" : StoreText.Price(order.ShippingTomans))</strong>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-top">
                            <span class="fw-semibold">مبلغ کل</span><strong>@StoreText.Price(order.TotalTomans)</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-panel">
                <h5 class="mb-3">اطلاعات گیرنده</h5>
                <div class="row g-3 small">
                    <div class="col-md-6"><span class="text-body-secondary">نام:</span> @order.CustomerName</div>
                    <div class="col-md-6"><span class="text-body-secondary">موبایل:</span> <span dir="ltr">@order.Phone</span></div>
                    <div class="col-md-6"><span class="text-body-secondary">استان:</span> @order.Province</div>
                    <div class="col-md-6"><span class="text-body-secondary">شهر:</span> @order.City</div>
                    <div class="col-12"><span class="text-body-secondary">نشانی:</span> @order.Address</div>
                    @if (!string.IsNullOrWhiteSpace(order.PostalCode))
                    {
                        <div class="col-md-6"><span class="text-body-secondary">کد پستی:</span> <span dir="ltr">@order.PostalCode</span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(order.Note))
                    {
                        <div class="col-12"><span class="text-body-secondary">یادداشت:</span> @order.Note</div>
                    }
                    @if (order.PaidAtUtc is not null)
                    {
                        <div class="col-md-6"><span class="text-body-secondary">زمان پرداخت:</span> @order.PaidAtUtc.Value.ToPersianDateTime()</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card-panel">
                <h5 class="mb-3">تغییر وضعیت</h5>
                <select class="form-select mb-3" @bind="selectedStatus">
                    @foreach (var status in Enum.GetValues<StoreOrderStatus>())
                    {
                        <option value="@status">@status.ToPersian()</option>
                    }
                </select>
                <button type="button" class="btn btn-primary w-100" @onclick="SaveStatusAsync" disabled="@saving">
                    @if (saving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    }
                    ذخیرهٔ وضعیت
                </button>
                <div class="text-body-secondary small mt-3">
                    لغو سفارش موجودی انبار را برنمی‌گرداند؛ در صورت نیاز موجودی را از صفحهٔ محصول اصلاح کنید.
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private StoreOrder? order;
    private StoreOrderStatus selectedStatus;
    private bool loading = true;
    private bool saving;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        loading = false;
    }

    private async Task LoadAsync()
    {
        order = await Orders.GetByIdAsync(Id);
        if (order is not null) selectedStatus = order.Status;
    }

    private Task SaveStatusAsync() => RunSafe(async () =>
    {
        saving = true;
        try
        {
            await Orders.UpdateStatusAsync(Id, selectedStatus);
            await LoadAsync();
            message = "وضعیت سفارش به‌روزرسانی شد.";
            Toast.ShowSuccess(message);
        }
        finally
        {
            saving = false;
        }
    });
}
